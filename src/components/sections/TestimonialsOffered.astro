---
import { Image } from 'astro:assets';
import Button from '../Button.astro';

const { image, mainHeading, coloredHeading, description, buttonText, buttonLink, buttonTwo_Part_1, buttonTwo_Part_2, buttonTwo_Number, list } = Astro.props.Content;
---

<section id="treatment" class="testimonials-offered mx-auto my-10 max-w-[1320px] px-4 min-[821px]:px-6 lg:px-0 relative overflow-hidden">
  <div class="flex flex-col min-[821px]:flex-row gap-6 min-[821px]:gap-10 justify-between items-center w-full">
    <div class="w-full min-[821px]:w-1/2">
      <img
        src={image}
        alt="Clear Path treatments illustration"
        class="object-contain w-full aspect-[1.57] rounded-3xl"
      />
    </div>
    <article class="w-full min-[821px]:w-1/2">
      <header class="w-full font-medium text-neutral-800">
        <h2>
          {mainHeading}
          <span class="text-[#5E81E9]">{coloredHeading}</span>
        </h2>
        <p set:html={description}>
        </p>
      </header>
    </article>
  </div>

  <div class="flex flex-col min-[821px]:flex-row gap-6 items-stretch mt-10 w-full">
    {list.map((item) => (
      <a href={item.link || '#'} class="flex-1 min-w-0" style="text-decoration: none; color: inherit;">
        <article class="flex flex-col flex-1 gap-2.5 items-start px-6 pt-6 pb-12 max-md:pb-6 bg-white rounded-3xl shadow-[0px_10px_40px_rgba(0,0,0,0.05)] w-full min-[821px]:w-auto h-full transition-all hover:shadow-lg">
          <div class="flex-1 w-full">
            <header class="w-full">
              <div class="flex overflow-hidden flex-col items-start w-full rounded-[100px]">
                <Image
                  src={item.image}
                  alt={`${item.title} icon`}
                  class="object-contain w-10 aspect-square"
                  width={40}
                  height={40}
                  loading="lazy"
                />
              </div>
                <h3
                class="mt-4 text-base font-bold text-neutral-800 !text-xl mb-2"
                >
                {item.title}
                </h3>
            </header>
            <p

            >
              {item.description}
            </p>

          </div>
          <Image
            src="/imgs/learn_more_indicator.svg"
            alt="Learn more indicator"
            class="object-contain mt-4 w-6 aspect-square self-start max-md:self-end"
            width={24}
            height={24}
            loading="lazy"
          />
        </article>
      </a>
    ))}
  </div>
  <div class="flex gap-3 justify-center max-md:flex-col max-md:w-full max-md:mx-auto max-md:mt-4 max-md:max-w-[400px] max-sm:gap-2.5 mt-8"> 
    <Button 
      buttonLink={buttonLink}
      buttonText={buttonText}
      buttonType="primary"
    />
    <Button
      buttonLink="/contact/"
      phoneTextOne="Have a question?"
      phoneTextTwo="Get in Touch"
      buttonType="phone"
    />
  </div>
</section>
