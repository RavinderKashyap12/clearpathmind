---
import VideoModal from "../VideoModal.astro"
import { Image } from 'astro:assets';

const { Content } = Astro.props;
const { heading, headingColored, description, image, imageAlt } = Content;
---

<section class="mx-auto my-20 max-w-[1320px] relative video-section">
    <div class="flex flex-col rounded-none">
        <h2 class="mt-4 max-w-[1000px] mx-auto text-center">
            {heading}
            <span style="color: rgba(94, 129, 233, 1)">{headingColored}</span>
        </h2>

        <article class="p-7 mt-12 w-full bg-indigo-500 rounded-3xl max-[1000px]:p-5 max-[1000px]:mt-8 max-[768px]:p-4 max-[768px]:mt-6 max-[480px]:p-3 max-[480px]:mt-4">
            <div class="flex gap-5 items-center max-[1000px]:flex-col max-[1000px]:gap-6">
              
            <div class="w-3/5 max-[1000px]:w-full">
                <p class="self-stretch my-auto !text-2xl font-normal text-white font-inter !leading-[39px] max-[1000px]:!text-xl max-[1000px]:!leading-8 max-[768px]:!text-lg max-[768px]:!leading-7 max-[480px]:!text-base max-[480px]:!leading-6" style="opacity: 0.75;" set:html=  {description}>
              
                </p>
            </div>
            <div class="ml-5 min-[1001px]:min-w-[485px] min-[1001px]:h-[330px] max-[1000px]:ml-0 max-[1000px]:w-full max-[1000px]:flex max-[1000px]:justify-center">
                <div class="bg-white p-3 rounded-2xl min-[1001px]:h-[100%] overflow-hidden">
                    <img
                    src={image}
                    alt={imageAlt}
                    class="object-cover w-full h-full rounded-xl min-[1001px]:rounded-xl min-[1001px]:h-[100%] max-[1000px]:max-w-md"
                    />
                </div>
            </div>
            </div>
        </article>
    </div>
</section>

<style>
@media (min-width: 1001px) and (max-width: 1319px) {
  .video-section {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
  }
}

@media (max-width: 1000px) {
  .video-section {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
    margin-top: 4rem;
    margin-bottom: 4rem;
  }
}

@media (max-width: 767px) {
  .video-section {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
    margin-top: 3rem;
    margin-bottom: 3rem;
  }
}

@media (max-width: 480px) {
  .video-section {
    margin-left: 1rem;
    margin-right: 1rem;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }
}

@media (max-width: 400px) {
  .video-section {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
}

@media (max-width: 1319px) {
  .responsive-heading {
    margin-top: 1.3rem;
    margin-bottom: 0.5rem;
    font-size: 2.25rem !important; /* 36px */
    line-height: 3rem !important;  /* 48px */
  }
}
@media (max-width: 1000px) {
  .responsive-heading {
    font-size: 1.875rem !important; /* 30px */
    line-height: 2.5rem !important; /* 40px */
  }
}
@media (max-width: 768px) {
  .responsive-heading {
    font-size: 1.5rem !important; /* 24px */
    line-height: 2rem !important;  /* 32px */
  }
}
@media (max-width: 480px) {
  .responsive-heading {
    font-size: 1.25rem !important; /* 20px */
    line-height: 1.5rem !important; /* 24px */
  }
}
</style>
