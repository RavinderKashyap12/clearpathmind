---
import { Image } from "astro:assets";
import Button from "../Button.astro";

const { headingOne, textOne, headingTwo, textTwo, images,buttonText,buttonLink,buttonTwo_Part_1,buttonTwo_Part_2,buttonTwo_Number } = Astro.props.Content;
---

<section class="mx-auto my-20 max-w-[1320px] max-md:my-8 relative program-about">
    <div class="rounded-none">
        <div class="flex gap-5 max-md:flex-col max-[820px]:flex-col">
            <article class="w-[56%] max-md:ml-0 max-md:w-full max-[820px]:ml-0 max-[820px]:w-full">
                <img
                    src={images.imageOne}
                    alt="Clear Path Treatment"
                    class="my-auto w-full h-full object-cover rounded-2xl max-md:mt-6 max-[820px]:mt-4 max-md:max-w-full max-[820px]:max-w-full"
                />
            </article>
            <article class="ml-5 w-[44%] max-md:ml-0 max-md:w-full max-[820px]:ml-0 max-[820px]:w-full">
                <div class="w-full max-md:mt-6 max-md:max-w-full max-[820px]:mt-6 max-[820px]:max-w-full">
                    <h2 
                    >
                      {headingOne}
                      <span class="text-[#5E81E9]">
                        {headingTwo}
                      </span>
                    </h2>
                    <p>

                      {textOne}
                    </p>
                    {textTwo && textTwo.trim() !== "" && (
                      <p class="mt-4">
                        {textTwo}
                      </p>
                    )}
                    <div class="flex gap-3 justify-center max-md:flex-col max-md:w-full max-md:mx-auto max-md:mt-4  max-md:max-w-[400px] max-sm:gap-2.5 mt-6">
                        <Button 
                          buttonLink={buttonLink}
                          buttonText={buttonText}
                          buttonType="primary"
                        />
                        <Button
                          buttonLink="/contact/"
                          phoneTextOne="Have a question?"
                          phoneTextTwo="Get in Touch"
                          buttonType="phone"
                        />
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<style>
/* Enhanced responsive breakpoints with improved spacing */
@media (min-width: 1321px) {
  .program-about {
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
}

@media (min-width: 1201px) and (max-width: 1320px) {
  .program-about {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
    margin-top: 4rem;
    margin-bottom: 4rem;
  }
}

@media (min-width: 1025px) and (max-width: 1200px) {
  .program-about {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }
}

@media (min-width: 901px) and (max-width: 1024px) {
  .program-about {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
    margin-top: 3rem;
    margin-bottom: 3rem;
  }
}

@media (min-width: 801px) and (max-width: 900px) {
  .program-about {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }
}

/* Significantly reduced margins below 800px */
@media (min-width: 701px) and (max-width: 800px) {
  .program-about {
    margin-left: 1rem;
    margin-right: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
}

