---
import Accordion from "../ui/Accordion.astro";

const { heading, subheading, faq } = Astro.props.Content;

---

<section class="flex flex-col justify-center items-center text-center gap-10 mx-auto my-14 max-w-[1320px] relative">
    <h2>
      {heading}
    </h2>
    <p set:html={subheading}></p>

  <div class="flex flex-col min-w-[1120px] max-w-[1120px] max-xl:min-w-full m-auto justify-center items-start self-stretch max-lg:gap-5 max-sm:gap-4">
    {faq.map((item, index) => (
      <Fragment>
        <details class="flex flex-col items-start self-stretch max-lg:gap-3 max-sm:gap-2 group w-full">
          <summary class="flex justify-between items-center self-stretch w-full cursor-pointer list-none pr-2 hover:bg-black/[0.02] rounded-lg transition-colors duration-200 py-4 px-2">
            <h3 class="!mb-0 !text-xl max-md:!text-lg text-left pr-4">
              {item.title}
            </h3>
            <div class="min-w-[24px] flex-shrink-0 max-lg:min-w-[20px] max-sm:min-w-[16px]">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                   class="faq-arrow transition-transform duration-300 group-open:rotate-180 max-lg:w-5 max-lg:h-5 max-sm:w-4 max-sm:h-4">
                <path d="M2.47888 7.88312L3.89813 6.46387L12.1326 14.6984L20.3671 6.46387L21.7864 7.88312L12.1326 17.5369L2.47888 7.88312Z" fill="#222222"></path>
              </svg>
            </div>
          </summary>
          <p class="max-lg:text-[15px] text-left max-w-full max-md:text-sm leading-7 text-neutral-800 opacity-75 group-open:pb-4 px-2">
            {item.details}
          </p>
          <div class="self-stretch h-px border-b border-solid border-b-neutral-800 group-open:hidden"></div>
        </details>
          <hr class="self-stretch h-px border-b border-solid border-b-neutral-800">
       
      </Fragment>
    ))}
  </div>
</section>

<style>
  /* Base styles for larger screens (above 1320px) remain unchanged */
  
  /* Responsive styles for screens below 1320px */
  @media (max-width: 1320px) {
    section {
      width: clamp(280px, 90%, 1050px);
      padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 2rem);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    header {
      width: clamp(280px, 85%, 756px);
      gap: clamp(0.5rem, 1vw, 0.75rem);
    }
  }

  /* Tablet styles (768px - 1024px) */
  @media (max-width: 1024px) {
    section {
      padding: 2rem 1.5rem;
      gap: 2.5rem;
    }

    details summary {
      padding: 0.75rem 0.75rem 0.75rem 0;
    }

    .faq-arrow {
      transform-origin: center;
    }
  }

  /* Mobile styles (below 768px) */
  @media (max-width: 768px) {
    section {
      padding: 1.5rem 1rem;
      gap: 2rem;
    }

    details summary {
      padding: 0.5rem 0.5rem 0.5rem 0;
    }
  }

  /* Small mobile styles (below 480px) */
  @media (max-width: 480px) {
    section {
      padding: 1.25rem 0.75rem;
      gap: 1.5rem;
    }

    details summary {
      padding: 0.375rem 0.375rem 0.375rem 0;
    }
  }

  /* Interactive styles */
  details summary {
    transition: all 0.2s ease;
  }

  details summary h3 {
    transition: color 0.2s ease;
  }

  details[open] summary {
    margin-bottom: 0.5rem;
  }

  details:hover summary h3 {
    color: rgb(64, 64, 64);
  }

  .faq-arrow {
    transition: transform 0.3s ease;
  }

  details[open] .faq-arrow {
    transform: rotate(180deg);
  }
</style>
</style>