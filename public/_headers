# HTTP response headers. These previously lived in _redirects, where Netlify's
# parser silently rejected all of them — the site shipped with no security or
# cache headers at all. Header rules belong here; _redirects is for redirects.

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Cache static assets
/imgs/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
