# Clear Path — form backend environment variables.
# Copy to `.env` for local dev, and set these in Netlify → Site settings →
# Environment variables for production. If the Mailgun vars are missing, the
# form API routes return HTTP 503 and the UI shows an "email us" fallback.

# --- Mailgun (required to actually send notification emails) ---
MAILGUN_API_KEY=            # Mailgun private API key
MAILGUN_DOMAIN=             # e.g. mg.clearpathmentalhealth.com
MAILGUN_REGION=us           # us | eu
NOTIFICATION_EMAIL=         # inbox that receives form submissions
EMAIL_FROM_NAME=Clear Path Behavioral Health
EMAIL_FROM_ADDRESS=noreply@clearpathmentalhealth.com

# --- CallTrackingMetrics Form Reactor (optional; lead forms only) ---
CONTACT_URL=                # CTM Form Reactor URL for the contact form
VERIFY_INSURANCE_URL=       # CTM Form Reactor URL for the verify-insurance form
